# ── Web app only ────────────────────────────────────────────────────────────
# The Claude Code plugin needs NONE of these: it authorises the Google Drive
# and Gmail connectors in your client and uses Claude itself as the model.

# Anthropic powers the app's own agent, the document extraction and the
# classifier. console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Claude model. Haiku 4.5 is fast and cheap and reads PDFs natively, which is
# what the document work needs; claude-sonnet-5 for harder reconciliation.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── The filing ──────────────────────────────────────────────────────────────
# Legal entity these documents belong to. Shown on every draft form.
ENTITY_NAME=Northwind Studio LLC

# Employer identification number. Masked everywhere it is displayed; set it
# only if you want the drafts to carry it.
ENTITY_TAX_ID=

# Who this app acts as. Every audit entry is attributed to this address, so it
# must be a real person while there is no sign-in.
PREPARER_EMAIL=

# Who the finished package goes to. Must not be the preparer — the whole point
# is that a second person reviews it before anything is filed.
TAX_MANAGER_EMAIL=

# ── Google ──────────────────────────────────────────────────────────────────
# The shared workspace folder every user's documents live in. The app's own
# grant is `drive.file` — it can reach the files it creates in this folder and
# nothing else in the owner's Drive.
#
# Each person using the app separately connects their own Google account from
# "Add documents", which grants `drive.readonly` so they can import a file they
# already have, and `gmail.send` so a finished package can go to their tax
# manager from their own address. No mailbox is ever read: that permission is
# not requested anywhere in this app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
# Written here automatically after visiting /api/drive/connect once.
GOOGLE_REFRESH_TOKEN=

# ── The MCP connector ───────────────────────────────────────────────────────
# Shared secret for /api/mcp, which is how Claude reaches the workspace. Until
# this is set the endpoint is closed and answers 503 — an unset variable fails
# shut rather than open, because the alternative turns a forgotten setting into
# a public delete_document. Generate with: openssl rand -base64 32
# The same value goes in the connector configuration.
MCP_TOKEN=
