# ── Web app only ────────────────────────────────────────────────────────────
# The Claude Code plugin needs NONE of these: it authorises the Google Drive
# and Gmail connectors in your client and uses Claude itself as the model.

# Anthropic powers the app's own agent, the document extraction and the
# classifier. console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Claude model. Haiku 4.5 is fast and cheap and reads PDFs natively, which is
# what the document work needs; claude-sonnet-5 for harder reconciliation.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── The filing ──────────────────────────────────────────────────────────────
# Legal entity these documents belong to. Shown on every draft form.
ENTITY_NAME=Northwind Studio LLC

# Employer identification number. Masked everywhere it is displayed; set it
# only if you want the drafts to carry it.
ENTITY_TAX_ID=

# Who this app acts as. Every audit entry is attributed to this address, so it
# must be a real person while there is no sign-in.
PREPARER_EMAIL=

# Who the finished package goes to. Must not be the preparer — the whole point
# is that a second person reviews it before anything is filed.
TAX_MANAGER_EMAIL=

# ── Connectors (not wired in this build) ────────────────────────────────────
# The collection sweep runs against the generated fixture corpus for now. When
# the Google Drive and Gmail connectors are added, these scope the sweep so it
# collects the filing period and nothing else.
DRIVE_FOLDER_ID=
GMAIL_QUERY=has:attachment (invoice OR receipt OR statement) after:2025/01/01 before:2025/04/01
